<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- image_picker launches the system camera/gallery via intents, so no
         runtime permission is declared here on purpose: declaring CAMERA
         would oblige us to request it and would break devices that only have
         a gallery. Marked not-required so phones without a camera can still
         install and use the typed onboarding path. -->
    <!-- Dictation. RECORD_AUDIO is requested at runtime by speech_to_text; the
         queries block is required on Android 11+ so the app can see that a
         speech recogniser exists at all. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Every call to Supabase and to the AI gateway needs this, and it was
         only ever declared in src/debug/AndroidManifest.xml — the manifest
         Flutter adds for hot reload, which is not merged into a release build.
         So debug builds could reach the backend and release builds silently
         could not: no crash, no permission prompt, just every network call
         failing on a phone where the app otherwise looks fine. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:label="Qamar"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Where Google, Apple and Facebook send the browser back to
                 after a sign-in. Without this the provider completes, the tab
                 closes, and the app never learns that it worked.

                 The same URL must be listed in the Supabase dashboard under
                 Authentication -> URL Configuration -> Redirect URLs, and it
                 must match AuthService.redirectUrl exactly. singleTop above is
                 what delivers the callback to the running activity instead of
                 starting a second copy of the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.qamar.app" android:host="login-callback"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.qamar.app" android:host="quick"/>
                <data android:scheme="com.qamar.app" android:host="ask"/>
                <data android:scheme="com.qamar.app" android:host="log"/>
            </intent-filter>
            <intent-filter>
                <action android:name="com.qamar.app.QUICK_ASK"/>
                <action android:name="com.qamar.app.QUICK_LOG"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
