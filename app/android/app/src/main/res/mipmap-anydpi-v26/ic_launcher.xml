<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8+). The launcher masks these two layers into
     whatever shape the device uses, so the orb sits on its own transparent
     layer over a flat night sky rather than being baked into a square.

     No <monochrome> layer on purpose: a themed icon flattens its drawable to
     a single tint, and this artwork is entirely made of coloured light — it
     would come out as a featureless blob. Without the tag, launchers using
     themed icons fall back to the full-colour icon, which is the better of
     the two outcomes. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
